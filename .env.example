# PersonalAI — environment configuration template.
# Copy to .env and fill in real values. NEVER commit the real .env file.

# --- Database ---
# Dev profile (default): SQLite file in the project root.
# Production profile: PostgreSQL via docker-compose.
DB_BACKEND=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personalai
DB_USER=postgres
DB_PASSWORD=change-me

# --- Content metadata ---
# No external metadata API is used: content features come from the MovieLens
# genome tags (see data/README.md). If an external source is added later,
# configure it here.

# --- Application ---
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
